rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsWorkspace(workspaceId) {
      return signedIn() && exists(/databases/$(database)/documents/workspaceMembers/$(workspaceId + '_' + request.auth.uid));
    }

    match /users/{userId} {
      allow read, update: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId;
    }

    match /workspaces/{workspaceId} {
      allow read: if ownsWorkspace(workspaceId);
      allow write: if false;
    }

    match /workspaceMembers/{memberId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /audits/{id} {
      allow read: if ownsWorkspace(resource.data.workspaceId);
      allow write: if false;
    }

    match /clients/{id} {
      allow read: if ownsWorkspace(resource.data.workspaceId);
      allow write: if false;
    }

    match /reports/{id} {
      allow read: if resource.data.isPublic == true || ownsWorkspace(resource.data.workspaceId);
      allow write: if false;
    }

    match /branding/{id} {
      allow read: if ownsWorkspace(id);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
